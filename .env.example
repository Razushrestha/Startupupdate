# Copy to `.env.local` and fill values (Next.js reads `.env.local` automatically).

# --- Google AdSense (optional) ---
# Publisher ID from AdSense → Account → Account information. Do not commit real IDs to public repos.
# NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxxxx
#
# Easiest: one responsive display unit → use default slot for every placement:
# NEXT_PUBLIC_ADSENSE_SLOT_DEFAULT=1234567890
#
# Better for policy & reporting: unique Display → Responsive units per placement (override default):
# NEXT_PUBLIC_ADSENSE_SLOT_IN_FEED=
# NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
# NEXT_PUBLIC_ADSENSE_SLOT_ANCHOR=
# NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_MID=
# NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_END=
#
# With a valid publisher ID, `/ads.txt` is served automatically for Google authorization.

ADMIN_SESSION_SECRET=long-random-string-for-signing-admin-session-cookies
ADMIN_PASSWORD=your-admin-console-password

# MongoDB Connection String — paste from MongoDB Compass (Connect → URI).
# Local (no auth) — add /database-name at the end:
# MONGODB_URI=mongodb://localhost:27017/startupupdate
# Atlas or auth:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/startupupdate?retryWrites=true&w=majority

MONGODB_URI=mongodb://localhost:27017/startupupdate
