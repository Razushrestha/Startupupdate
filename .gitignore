# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# typescript
*.tsbuildinfo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local visitor counter (dev)
/data/site-visitors.json

# Admin-uploaded news covers (keep folder via .gitkeep)
/public/uploads/news/*
!/public/uploads/news/.gitkeep

/public/uploads/startups/*
!/public/uploads/startups/.gitkeep
